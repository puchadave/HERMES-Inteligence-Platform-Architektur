COMPOSE_PROJECT_NAME=odysseus
TZ=Europe/Berlin

# Public development hostnames. They resolve to localhost in modern browsers.
TRAEFIK_HOST=traefik.localhost
AUTH_HOST=auth.localhost
SEARCH_HOST=search.localhost
API_HOST=api.localhost
GRAFANA_HOST=grafana.localhost

# Bootstrap credentials. scripts/bootstrap.sh replaces CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME
MINIO_ROOT_USER=odysseus
MINIO_ROOT_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
NATS_USER=odysseus
NATS_PASSWORD=CHANGE_ME

# Optional ORCID federation. Leave blank to keep the provider disabled.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ENABLED=false

# ProtonVPN / Gluetun profile. WireGuard is recommended.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Germany

# External provider adapters used by the edge client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ODYSSEUS_API_URL=http://api.localhost
ODYSSEUS_ACCESS_TOKEN=
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=local-model

# MCP server and bundled OSINT tool versions.
OPENOSINT_VERSION=2.25.0
SUPERGATEWAY_VERSION=3.4.3
HOLEHE_VERSION=1.61
SHERLOCK_PROJECT_VERSION=0.16.0
SUBLIST3R_VERSION=1.0
PHONEINFOGA_VERSION=2.11.0
PHONEINFOGA_SHA256=6173dfc4ec009a6fe688068bac5a250646f5a8f56409098f5edcc7e404b12a52
GITHUB_MCP_TOKEN=

# Background research worker.
ODYSSEUS_SCHEDULER_ENABLED=true
ODYSSEUS_SCHEDULER_POLL_SECONDS=30
ODYSSEUS_MAX_PARALLEL_TOOLS=3
ODYSSEUS_ENABLE_BBOT=false
ODYSSEUS_BBOT_TIMEOUT_SECONDS=900
ODYSSEUS_ENABLE_PAID_OSINT=false
ODYSSEUS_MAX_DELIVERIES=5
ODYSSEUS_ACK_HEARTBEAT_SECONDS=20

# Optional OpenOSINT provider keys. Keyless tools remain available without them.
HIBP_API_KEY=
IPINFO_TOKEN=
IP2LOCATION_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_SECRET=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# Evidence storage profile.
EVIDENCE_BUCKET=odysseus-evidence
