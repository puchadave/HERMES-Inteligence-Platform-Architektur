COMPOSE_PROJECT_NAME=odysseus
TZ=Europe/Berlin

# Public development hostnames. They resolve to localhost in modern browsers.
TRAEFIK_HOST=traefik.localhost
AUTH_HOST=auth.localhost
SEARCH_HOST=search.localhost
API_HOST=api.localhost
GRAFANA_HOST=grafana.localhost

# Bootstrap credentials. scripts/bootstrap.sh replaces CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME
MINIO_ROOT_USER=odysseus
MINIO_ROOT_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
NATS_USER=odysseus
NATS_PASSWORD=CHANGE_ME

# Optional ORCID federation. Leave blank to keep the provider disabled.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ENABLED=false

# ProtonVPN / Gluetun profile. WireGuard is recommended.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Germany

# External provider adapters used by the edge client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ODYSSEUS_API_URL=http://api.localhost
ODYSSEUS_ACCESS_TOKEN=
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=local-model

# Evidence storage profile.
EVIDENCE_BUCKET=odysseus-evidence
